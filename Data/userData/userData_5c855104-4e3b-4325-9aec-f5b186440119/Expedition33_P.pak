AudioMixerModuleName=AudioMixerXAudio2
PlatformFormat=OGG
PlatformStreamingFormat=OGG
PlatformHeadroomDB=-3

[TextureStreaming]
PoolSizeVRAMPercentage=70
r.Streaming.PoolSize=1024
r.Streaming.LimitPoolSizeToVRAM=1
r.Streaming.DefragDynamicBounds=1
r.VirtualTexture=0

[SystemSettings]
r.setres=1280x720
r.ScreenPercentage=80
r.ViewDistanceScale=0.6
r.ShadowQuality=1
r.PostProcessQuality=1
r.TextureQuality=2
r.EffectsQuality=1
r.FoliageQuality=0
r.AntiAliasingQuality=2
r.VolumetricFog=0
r.MotionBlurQuality=0
r.Lumen=0
r.Lumen.Reflections.Enable=0
r.Lumen.Reflections.HighQuality=0
r.Lumen.Reflections.ScreenTraces=0
r.GlobalIllumination=0
r.SSR=0
r.AmbientOcclusion=0
r.Tonemapper.GrainQuantization=0
r.Nanite=0
r.VirtualTextureEnableCompressZlib=0
r.VirtualTextureMipBias=1
r.Streaming.FramesForFullUpdate=2
r.Streaming.HLODStrategy=1

[PlatformCrypto]
PlatformRequiresDataCrypto=False

[/Script/Engine.RendererSettings]
r.AsyncCompute=1
r.Shaders.RemoveUnusedInterpolators=1
r.UseShaderCaching=1
r.CompileShadersForDevelopment=0
r.Shaders.Optimize=1
r.Shaders.Validation=0
r.CookOutUnusedDetailModeComponents=1
r.GTSyncType=1
r.ShaderPipelineCache.Enabled=1
r.ShaderPipelineCache.SaveUserCache=1
r.ParallelRendering=1
r.ParallelShadows=1
r.ParallelTranslucency=1
r.ParallelPhysicsScene=1
r.ParallelSceneCapture=1
r.ParallelMeshProcessing=1
r.Bloom.AsyncCompute=1
r.Streaming.UseAsyncRequestsForDDC=1
r.FastBlurThreshold=0
r.BlurGBuffer=0
r.OptimizedWPO=1
r.UseFastIntersect=1

[/Script/Engine.InputSettings]
RawMouseInputEnabled=True
bDisableMouseAcceleration=True

[/Script/Engine.Engine]
bAllowMultiThreadedShaderCompile=True
bEnableMultiCoreRendering=True

[/Script/Engine.GarbageCollectionSettings]
gc.AllowParallelGC=1
gc.CreateGCClusters=1
gc.ActorClusteringEnabled=0

[CrashReportClient]
bAgreeToCrashUpload=False
bImplicitSend=False

[/Script/WInstrumentedProfilersSettings.WTelemetrySettings]
bEnableTelemetry=False

[Core.Log]
Global=off
