{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "VCS_DOCs.TaskEngine": "Information",
      "TaskModule.support.email-reminder": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=D:\\Unity\\VCS-DOCs\\VCS-DOCs.Infrastructure\\VCSDocs.db"
  },
  "Captcha": {
    "Enabled": true,
    "Provider": "LocalCaptcha"
  },
  "VDocs": {
    "BaseUrl": "https://vcs-docs.support.local:7120/",
    "SupportApiKey": "1Z3EmoXaaq54kRD3XosbVZn97NFADfUPLeK5FzlJwpL="
  },
  "TaskEngine": {
    "Enabled": true,
    "ModulesPath": "Modules",
    "ScanPeriodSeconds": 5,
    "MaxConcurrency": 2,
    "ThrowOnModuleError": false
  },
  "Modules": {
    "EmailReminder": {
      "AutoCloseEnabled": true,
      "AutoCloseAfterHours": 72,
      "ReplyDelayHours": 24,
      "IdleDelayHours": 72,
      "RunEverySeconds": 300,
      "OperatorRoles": [ "agent" ],
      "RespectEmailNotifyForIdle": false,
      "UseLocalTime": false,
      "RequireFollowUpBeforeAutoClose": true,
      "AutoCloseSendEmail": true
    },
    "AutoAssign": {
      "RunEverySeconds": 60,
      "MaxPerAgent": 50,
      "BatchLimit": 100,
      "IncludeAdmins": true,
      "RoleAgent": "SupportAgent",
      "RoleAdmin": "SupportAdmin"
    },
    "Mail": {
      "Host": "127.0.0.1",
      "Port": 2525,
      "UseSsl": false,
      "From": "VCS-DOCs Support <no-reply@vcs-support.local>"
    },
    "Uploads": {
      "Support": {
        "Root": "D:\\Unity\\VCS-DOCs\\VCS-DOCs.Support\\App_Data\\SupportFiles",
        "MaxSizeMb": 50,
        "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".pdf", ".docx", ".xlsx", ".txt", ".zip", ".7z" ]
      }
    },
    "TicketUrlTemplate": "https://vcs-docs.support.local:7120/Support/Tickets/{id}",
    "WebBaseUrl": "https://vcs-docs.local:7120",
    "AllowedHosts": "*"
  }
}
