  <ItemGroup>
    <Folder Include="App_Data\SupportFiles\" />
    <Folder Include="App_Data\SupportFiles\a46b28e5\" />
    <Folder Include="Modules\" />
  </ItemGroup>

  <!-- Если вручную кладёшь файлы в Modules в проекте — это скопирует их -->
  <ItemGroup>
    <None Include="Modules\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Pages\Content\Users\user_open_tickets.cshtml~RFe3635d.TMP" />
  </ItemGroup>

  <!-- Гарантируем существование папки Modules -->
  <Target Name="EnsureModulesFolder" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\Modules" />
  </Target>

  <!-- Копируем DLL модулей из их выходных папок в bin\...\Modules -->
  <Target Name="CopyExternalModules" AfterTargets="Build">
    <ItemGroup>
      <BuiltModuleDlls Include="..\VCS-DOCs.TaskModule.EmailReminder\bin\$(Configuration)\$(TargetFramework)\VCS-DOCs.TaskModule.EmailReminder.dll" />
    </ItemGroup>
    <Message Text="Copying modules to $(OutputPath)Modules" Importance="high" />
    <Copy SourceFiles="@(BuiltModuleDlls)" DestinationFolder="$(OutputPath)Modules" SkipUnchangedFiles="true" />
  </Target>

  <!-- И в publish -->
  <Target Name="CopyExternalModulesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <BuiltModuleDlls Include="..\VCS-DOCs.TaskModule.EmailReminder\bin\$(Configuration)\$(TargetFramework)\VCS-DOCs.TaskModule.EmailReminder.dll" />
    </ItemGroup>
    <Message Text="Copying modules to $(PublishDir)Modules" Importance="high" />
    <Copy SourceFiles="@(BuiltModuleDlls)" DestinationFolder="$(PublishDir)Modules" SkipUnchangedFiles="true" />
  </Target>

</Project>
