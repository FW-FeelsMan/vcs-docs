    <ProjectReference Include="..\VCS-DOCs.TaskEngine\VCS-DOCs.TaskEngine.csproj" />
    <ProjectReference Include="..\VCS-DOCs.Upload.Core\VCS-DOCs.Upload.Core.csproj" />
    <ProjectReference Include="..\VCS-DOCs.WebCAD\VCS-DOCs.WebCAD.csproj" />
    <ProjectReference Include="..\VCS-DOCs.Web\VCS-DOCs.Web.csproj" />

    <!-- ССЫЛКА НА МОДУЛЬ, ЧТОБЫ ОН СТРОИЛСЯ, НО НЕ ПОДКЛЮЧАЛСЯ К ХОСТУ КАК ЗАВИСИМОСТЬ -->
