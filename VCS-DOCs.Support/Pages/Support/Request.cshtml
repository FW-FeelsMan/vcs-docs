@page
@model VCS_DOCs.Support.Pages.Support.RequestModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Обращение в поддержку";
}
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]


@inject Microsoft.Extensions.Configuration.IConfiguration Cfg

@section Styles {
    <link rel="stylesheet" href="~/css/support-request.css" asp-append-version="true" />
}

<!-- Тёмный анимированный фон -->
<div class="bg-anim" aria-hidden="true"></div>

<main class="support-wrap">
    <div class="support-card">
        <h2>Обращение в поддержку</h2>
        <p class="muted">Опишите проблему как можно подробнее. Мы пришлём ответ на указанную почту.</p>

        <form id="supportForm"
              data-captcha-enabled="@(Model.CaptchaEnabled ? "true" : "false")"
              data-captcha-provider="@Model.CaptchaProvider"
              data-captcha-sitekey="@Model.CaptchaSiteKey">
            @Html.AntiForgeryToken()
            <div class="grid">
                <div>
                    <label for="supFullName">ФИО</label>
                    <input id="supFullName" name="fullName" type="text" placeholder="Иванов Иван Иванович"
                           maxlength="80" data-maxlen="80" />
                    <small class="field-hint" data-hint-for="fullName" style="display:none;">Не более 80 символов</small>
                </div>
                <div>
                    <label for="supLogin">Логин</label>
                    <input id="supLogin" name="login" type="text" placeholder="логин (если есть)"
                           maxlength="20" data-maxlen="20" />
                    <small class="field-hint" data-hint-for="login" style="display:none;">Не более 20 символов</small>
                </div>
            </div>

            <div class="grid">
                <div>
                    <label for="supEmail">Почта для ответа</label>
                    <input id="supEmail" name="replyTo" type="email" placeholder="you@example.com"
                           maxlength="100" data-maxlen="100" />
                </div>
                <div>
                    <label for="supSubject">Тема</label>
                    <input id="supSubject" name="subject" type="text" placeholder="Коротко о проблеме"
                           maxlength="100" data-maxlen="100" />
                    <small class="field-hint" data-hint-for="subject" style="display:none;">Не более 100 символов</small>
                </div>
            </div>

            <label for="supMessage">Текст обращения</label>
            <textarea id="supMessage" name="message" placeholder="Что произошло?... "
                      rows="6" maxlength="4000" data-maxlen="4000"></textarea>
            <small class="field-hint" data-hint-for="message" style="display:none;">Не более 4000 символов</small>

            <!-- Captcha -->
            <div class="captcha-row">
                <div id="captchaContainerV2" style="display:none"></div>

                <div id="captchaContainerLocal" style="display:none; align-items:center; gap:10px;">
                    <img id="captchaImage" alt="Капча" />
                    <button id="captchaRefresh" class="btn secondary" data-click="throttle:800" type="button">Обновить</button>
                    <input id="captchaAnswer" name="captchaAnswer" type="text" placeholder="Ответ"
                           maxlength="10" data-maxlen="10" />
                </div>
            </div>

            <div class="actions">
                <a class="btn primary home-link" href="https://vcs-docs.local:7120/" data-click="throttle:800" target="_top" rel="noopener">
                    На главную
                </a>
                <button class="btn primary" type="submit" data-click="throttle:800">Отправить</button>
            </div>

            <div class="tiny muted" style="margin-top:8px;">
                Тех.инфо приложим автоматически (URL, TraceId, User-Agent).
            </div>
        </form>
        <div class="sr-loader" id="srLoader"><div class="sr-spinner"></div></div>
        <div class="sr-result" id="srPanel" aria-live="polite">
            <h3 id="srTitle">Подтверждение</h3>
            <p id="srText">—</p>
            <div class="sr-actions">
                <button type="button" class="sr-btn primary" id="srConfirm">Создать и отправить</button>
                <button type="button" class="sr-btn secondary" id="srCancel">Отмена</button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/support-request.js" asp-append-version="true" defer></script>
}
