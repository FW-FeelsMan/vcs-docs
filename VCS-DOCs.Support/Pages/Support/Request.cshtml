@page
@model VCS_DOCs.Support.Pages.Support.RequestModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Обращение в поддержку";
}

@section Styles {
    <link rel="stylesheet" href="~/css/support-request.css" asp-append-version="true" />
}

<!-- Тёмный анимированный фон -->
<div class="bg-anim" aria-hidden="true"></div>

<main class="support-wrap">
    <div class="support-card">
        <h2>Обращение в поддержку</h2>
        <p class="muted">Опишите проблему как можно подробнее. Мы пришлём ответ на указанную почту.</p>

        <form id="supportForm"
              data-captcha-enabled="@(Model.CaptchaEnabled ? "true" : "false")"
              data-captcha-provider="@Model.CaptchaProvider"
              data-captcha-sitekey="@Model.CaptchaSiteKey">

            <div class="grid">
                <div>
                    <label for="supFullName">ФИО</label>
                    <input id="supFullName" name="fullName" type="text" placeholder="Иванов Иван Иванович" />
                </div>
                <div>
                    <label for="supLogin">Логин</label>
                    <input id="supLogin" name="login" type="text" placeholder="логин (если есть)" />
                </div>
            </div>

            <div class="grid">
                <div>
                    <label for="supEmail">Почта для ответа</label>
                    <input id="supEmail" name="replyTo" type="email" placeholder="you@example.com" />
                </div>
                <div>
                    <label for="supSubject">Тема</label>
                    <input id="supSubject" name="subject" type="text" placeholder="Коротко о проблеме" />
                </div>
            </div>

            <label for="supMessage">Текст обращения</label>
            <textarea id="supMessage" name="message" placeholder="Что произошло? Какие шаги приводят к ошибке?" rows="6"></textarea>

            <!-- Captcha -->
            <div class="captcha-row">
                <div id="captchaContainerV2" style="display:none"></div>

                <div id="captchaContainerLocal" style="display:none; align-items:center; gap:10px;">
                    <img id="captchaImage" alt="Капча" />
                    <button id="captchaRefresh" class="btn secondary" type="button">Обновить</button>
                    <input id="captchaAnswer" name="captchaAnswer" type="text" placeholder="Ответ" />
                </div>
            </div>

            <div class="actions">
                <a class="btn primary home-link" href="https://vcs-docs.local:7120/" target="_top" rel="noopener">
                    На главную
                </a>
                <button class="btn primary" type="submit">Отправить</button>
            </div>

            <div class="tiny muted" style="margin-top:8px;">
                Тех.инфо приложим автоматически (URL, TraceId, User-Agent).
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <script src="~/js/support-request.js" asp-append-version="true" defer></script>
}
