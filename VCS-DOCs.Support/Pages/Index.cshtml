@page
@using VCS_DOCs.Infrastructure.Auth
@model VCS_DOCs.Support.Pages.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Панель заявок";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Af
@{
    var tokens = Af.GetAndStoreTokens(HttpContext);
}
<meta name="csrf-token" content="@tokens.RequestToken" />

@section Styles {
    <!-- делаем этот css «постоянным» как в вебе -->
    <link id="supportMain" data-persistent="true" rel="stylesheet" href="~/css/main_css/mainStyle.css" asp-append-version="true" />
}

<div id="loader" class="loader hidden"></div>
<div class="background"></div>

<!-- Заголовок -->
<div class="header-container">
    <div class="header-title">VCS-DOCs</div>
    <p class="menu_divider">SERVICE<br />DESK</p>
</div>

<!-- Левое меню -->
<div class="sidebar">
    @* === SupportAdmin === *@
    @if (User.IsInRole(Roles.SupportAdmin))
    {
        <div class="sidebar-button selected" data-content="user_tickets" data-style="supportMain" id="btn-tickets">
            <img src="~/images/helpIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Заявки пользователей</span>
            <span class="button-number">1</span>
        </div>
        <div class="sidebar-button" data-content="closed_tickets" data-style="supportMain" id="btn-closed">
            <img src="~/images/projectsIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Закрытые заявки</span>
            <span class="button-number">2</span>
        </div>
        <div class="sidebar-button" data-content="my_work" data-style="supportMain" id="btn-mywork">
            <img src="~/images/projectsIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Мои закрытые</span>
            <span class="button-number">3</span>
        </div>
        <div class="sidebar-button" data-content="accounts" data-style="supportMain" id="btn-accounts">
            <img src="~/images/extra.png" alt="Icon" class="button-icon" />
            <span class="button-text">Учетные записи</span>
            <span class="button-number">4</span>
        </div>
        <div class="sidebar-button" data-content="workload" data-style="supportMain" id="btn-workload">
            <img src="~/images/infographicIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Нагрузка</span>
            <span class="button-number">5</span>
        </div>
    }
    @* === SupportAgent === *@
    else if (User.IsInRole(Roles.SupportAgent))
    {
        <div class="sidebar-button selected" data-content="user_tickets" data-style="supportMain" id="btn-tickets">
            <img src="~/images/helpIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Заявки пользователей</span>
            <span class="button-number">1</span>
        </div>
        <div class="sidebar-button" data-content="closed_tickets" data-style="supportMain" id="btn-closed">
            <img src="~/images/projectsIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Закрытые заявки</span>
            <span class="button-number">2</span>
        </div>
        <div class="sidebar-button" data-content="my_work" data-style="supportMain" id="btn-mywork">
            <img src="~/images/projectsIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Мои закрытые</span>
            <span class="button-number">3</span>
        </div>
        <div class="sidebar-button" data-content="accounts" data-style="supportMain" id="btn-accounts">
            <img src="~/images/extra.png" alt="Icon" class="button-icon" />
            <span class="button-text">Учетные записи</span>
            <span class="button-number">4</span>
        </div>
    }
    @* === fallback (BaseUser / гость), если нужно оставить доступ === *@
    else
    {
        <div class="sidebar-button selected" data-content="open_tickets" data-style="supportMain" id="btn-open">
            <img src="~/images/helpIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Открытые заявки</span>
            <span class="button-number">1</span>
        </div>
        <div class="sidebar-button" data-content="closed_tickets" data-style="supportMain" id="btn-closed">
            <img src="~/images/projectsIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">Закрытые заявки</span>
            <span class="button-number">2</span>
        </div>
        <div class="sidebar-button" data-content="faq" data-style="supportMain" id="btn-faq">
            <img src="~/images/infographicIcon.png" alt="Icon" class="button-icon" />
            <span class="button-text">FAQ по системе</span>
            <span class="button-number">3</span>
        </div>
    }

    <div class="user-block">
        <img id="sidebarAvatar" src="@Model.AvatarUrl" alt="Avatar" class="sidebar-avatar-img" />
        <div class="user-info">
            <div class="user-name">@((Model.CurrentUser?.UserName ?? User?.Identity?.Name) ?? "Пользователь")</div>
            <div class="main-user-status connecting">Подключение…</div>
        </div>
    </div>

    <form method="post" asp-page-handler="Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="logout-button" title="Выйти">
            <img src="~/images/logout_icon.png" alt="Выход" class="logout-icon" />
        </button>
    </form>
</div>

<!-- Контент -->
<div id="content" class="content-field">
    <!-- JS сам подменит содержимое панелью с анимацией -->
</div>

<!-- контекстное меню (пока без JS) -->
<div class="context-menu" id="ctx-menu">
    <ul>
        <li>Открыть</li>
        <li>Назначить</li>
        <li>Закрыть</li>
        <hr />
        <li>Обновить</li>
    </ul>
</div>
@section Scripts {
    <script src="~/js/support/support-sidebar.js" asp-append-version="true" defer></script>
}
