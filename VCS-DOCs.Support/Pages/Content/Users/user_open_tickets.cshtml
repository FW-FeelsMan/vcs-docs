@page "/Content/Users/user_open_tickets"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "SupportDeskAccess")]
@model VCS_DOCs.Support.Pages.Content.Users.UserOpenTicketsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
}
<link rel="stylesheet" href="~/css/sub_css/support_accountsStyle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/sub_css/user_opentickets_css/user_opentickets.css" asp-append-version="true" />
<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<style>
    /* мини-стили модалки создания заявки */
    .embed-modal {
        position: fixed;
        inset: 0;
        display: none;
        place-items: center;
        z-index: 9999;
    }

        .embed-modal.show {
            display: grid;
        }

        .embed-modal .embed-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,.45);
            backdrop-filter: blur(1px);
        }

     .embed-modal .embed-dialog {
         position: relative;
         width: min(960px, 96vw);
         height: min(680px, 92vh);
         background: transparent; 
         border-radius: 0; 
         box-shadow: none; 
         overflow: hidden;        
    }

    .embed-dialog iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
        /*background: #fafafa;*/
        background: transparent;
    }

    .embed-close {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 10px;
        background: #f2f3f5;
        cursor: pointer;
        font-size: 18px;
        line-height: 36px;
    }

    .button-container {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .inline-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .inline-actions {
        margin-left: auto;
    }
</style>

<div id="user-open-tickets" class="profile_background accounts-page tickets-page">
    <div class="button-container">
        <h2>Открытые заявки</h2>

        <div class="inline-controls">
            <input id="user_searchBox" class="user_searchBox" type="text" placeholder="Поиск (№ или тема)" />
            <button id="btn-search" class="button-sliding small">Найти</button>
        </div>

        <div class="inline-actions">
            <button id="btn-create-ticket" class="button-sliding primary small">Создать заявку</button>
        </div>
    </div>

    <div class="tickets-legend">
        <span class="legend-item"><i class="legend-dot op"></i> Оператор ожидает ответ</span>
        <span class="legend-item"><i class="legend-dot usr"></i> Пользователь ожидает ответ</span>
    </div>

    <hr class="solid" />

    <div class="content-scrollable">
        <table class="file-table" id="ticketsTable">
            <colgroup>
                <col style="width:80px" />
                <col style="width:200px" />
                <col style="width:200px" />
                <col style="width:140px" />
                <col style="width:130px" />
                <col style="width:170px" />
                <col style="width:150px" />
            </colgroup>
            <thead>
                <tr>
                    <th>№</th>
                    <th>Тема</th>
                    <th>Статус</th>
                    <th>Создано</th>
                    <th>Обновлено</th>
                    <th>E-mail уведомления</th>
                    <th>Действие</th>
                </tr>
            </thead>
            <tbody id="userOpenTicketsBody"></tbody>

            <tfoot class="table-spacer">
                <tr><td colspan="7"></td></tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- модалка со встроенной формой создания заявки -->
<div id="newTicketModal" class="embed-modal" aria-hidden="true">
    <div class="embed-backdrop" id="newTicketBackdrop"></div>
    <div class="embed-dialog">
        <button class="embed-close" id="newTicketClose" title="Закрыть">×</button>
        <iframe id="newTicketFrame"
                src=""
                loading="eager"
                referrerpolicy="no-referrer"
                allow="clipboard-read; clipboard-write"></iframe>
    </div>
</div>

<script src="~/js/user/user_open_tickets.js" asp-append-version="true" defer></script>
