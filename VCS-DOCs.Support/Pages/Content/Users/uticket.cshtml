@page "/Content/Users/uticket/{id}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "SupportDeskAccess")]
@model VCS_DOCs.Support.Pages.Content.Users.UserTicketThreadModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
}
<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
<link rel="stylesheet" href="~/css/sub_css/support_accountsStyle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/sub_css/operator_tickets_css/ticket_thread.css" asp-append-version="true" />

<style>
    .tt-attach {
        margin-right: 8px;
    }

    .tt-attach-list {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin: 6px 0 0;
    }

    .tt-attach-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 2px 6px;
        background: #f7f7f7;
    }

        .tt-attach-pill small {
            color: #888;
            margin-left: 4px;
        }

        .tt-attach-pill button {
            border: 0;
            background: transparent;
            cursor: pointer;
            font-size: 14px;
        }

    .tt-files {
        margin-top: 6px;
    }

        .tt-files .tt-file {
            display: inline-block;
            margin-right: 8px;
        }
</style>

<div id="ticket-thread"
     class="profile_background accounts-page tickets-page"
     data-ticket-id="@Model.Id"
     data-subject="@Request?.Query["subject"]"
     data-from="@(Request?.Query["from"].ToString() ?? "open_tickets")">

    <div class="button-container tt-header">
        <button id="tt_back" class="btn-back-ghost btn-sm" type="button">
            <span class="chev" aria-hidden="true">‹</span>
            <span>Вернуться</span>
        </button>
        <h2 id="tt_title">
            Заявка <span id="tt_id">@Model.Id</span>
            <span class="tt-subject muted">Тема: <span id="tt_subject">—</span></span>
        </h2>
    </div>

    <hr class="solid" />

    <div class="content-scrollable tt-wrap">
        <div class="tt-meta">
            <div><b>№:</b> <span id="tt_id_dup">@Model.Id</span></div>
            <div><b>Статус:</b> <span id="tt_status">Открыта</span></div>
            <div><b>Создано:</b> <span id="tt_created">—</span></div>
            <div><b>Обновлено:</b> <span id="tt_updated">—</span></div>
        </div>

        <div id="tt_messages" class="tt-messages"></div>
    </div>

    <div class="tt-input">
        <button id="tt_attach" class="tt-plus" aria-label="Прикрепить файл"></button>
        <input id="tt_files" type="file" multiple>
        <div id="tt_attach_list" class="tt-attach-list"></div>

        <textarea id="tt_text" rows="3"
                  placeholder="Напишите ответ… (Ctrl+Enter — отправить, ≤ 1500 символов)"
                  maxlength="1500"></textarea>

        <button id="tt_send" type="button" class="btn-pill btn-send">
            <svg class="ico-plane" viewBox="0 0 24 24" aria-hidden="true">
                <!-- простая «paper plane», красится через currentColor -->
                <path fill="currentColor"
                      d="M2.2 11.4c-.4.2-.4.9 0 1l6.7 2.7c.2.1.4.3.5.5l2.7 6.7c.2.4.9.4 1 0l8.4-19.1c.2-.5-.3-1-.8-.8L2.2 11.4Zm7.5.9 7.4-6.2-5.8 8.3c-.1.1-.1.3 0 .4l1.6 3.9-3.2-6.4c0-.1 0-.1 0-.2Z" />
            </svg>
            <span>Отправить</span>
        </button>
    </div>

</div>

<script src="~/js/user/user_ticket_thread.js" asp-append-version="true" defer></script>