@page "/Content/Users/uticket/{id}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "SupportDeskAccess")]
@model VCS_DOCs.Support.Pages.Content.Users.UserTicketThreadModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
}
<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
<link rel="stylesheet" href="~/css/sub_css/support_accountsStyle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/sub_css/operator_tickets_css/ticket_thread.css" asp-append-version="true" />

<style>
    .tt-attach {
        margin-right: 8px;
    }

    .tt-attach-list {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin: 6px 0 0;
    }

    .tt-attach-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 2px 6px;
        background: #f7f7f7;
    }

        .tt-attach-pill small {
            color: #888;
            margin-left: 4px;
        }

        .tt-attach-pill button {
            border: 0;
            background: transparent;
            cursor: pointer;
            font-size: 14px;
        }

    .tt-files {
        margin-top: 6px;
    }

        .tt-files .tt-file {
            display: inline-block;
            margin-right: 8px;
        }
</style>

<div id="ticket-thread"
     class="profile_background accounts-page tickets-page"
     data-ticket-id="@Model.Id"
     data-subject="@Request?.Query["subject"]"
     data-from="@(Request?.Query["from"].ToString() ?? "open_tickets")">

    <div class="button-container tt-header">
        <button id="tt_back" class="button-sliding small">← Вернуться</button>
        <h2 id="tt_title">
            Заявка <span id="tt_id">@Model.Id</span>
            <span class="tt-subject muted">Тема: <span id="tt_subject">—</span></span>
        </h2>
    </div>

    <hr class="solid" />

    <div class="content-scrollable tt-wrap">
        <div class="tt-meta">
            <div><b>№:</b> <span id="tt_id_dup">@Model.Id</span></div>
            <div><b>Статус:</b> <span id="tt_status">Открыта</span></div>
            <div><b>Создано:</b> <span id="tt_created">—</span></div>
            <div><b>Обновлено:</b> <span id="tt_updated">—</span></div>
        </div>

        <div id="tt_messages" class="tt-messages"></div>
    </div>

    <div class="tt-input">
        <button id="tt_attach" class="button-sliding tt-attach">Прикрепить файл</button>
        <input id="tt_files" type="file" multiple style="display:none" />
        <div id="tt_attach_list" class="tt-attach-list"></div>

        <textarea id="tt_text" rows="3" placeholder="Напишите ответ… (Ctrl+Enter — отправить)"></textarea>
        <button id="tt_send" class="button-sliding primary">Отправить</button>
    </div>
</div>

<script src="~/js/user/user_ticket_thread.js" asp-append-version="true" defer></script>