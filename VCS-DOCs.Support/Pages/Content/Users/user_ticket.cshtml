@page
@model VCS_DOCs.Support.Pages.Content.Users.UserTicketModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Заявка";
}

<section class="card">
    <h2>Заявка <span id="tkid"></span></h2>
    <div class="muted" id="tksubj"></div>
    <div id="chat" style="margin-top:12px; border:1px solid var(--border); padding:12px; height:420px; overflow:auto;"></div>

    <div style="display:flex; gap:8px; margin-top:10px;">
        <input id="msg" type="text" class="input" placeholder="Сообщение…" style="flex:1;" />
        <button id="send" class="btn primary">Отправить</button>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>
    <script>
        const url = new URL(window.location.href);
        const ticketId = url.searchParams.get('id') || '';
        document.getElementById('tkid').textContent = ticketId;

        const chat = document.getElementById('chat');
        const subj = document.getElementById('tksubj');
        const input = document.getElementById('msg');
        const btn = document.getElementById('send');

        function esc(s) { return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
        function rowHtml(m) {
            const who = m.role === 'agent' ? 'Оператор' : 'Вы';
            return `<div class="msg ${m.role}">
                <div class="meta"><b>${who}</b> • ${new Date(m.createdAt).toLocaleString()}</div>
                <div class="body">${esc(m.body)}</div>
            </div>`;
        }
        function scrollDown(){ chat.scrollTop = chat.scrollHeight; }

        async function loadTicket() {
            const r = await fetch(`/api/support/tickets/${encodeURIComponent(ticketId)}`, { credentials: 'include' });
            if (!r.ok) { chat.innerHTML = 'Не удалось загрузить заявку'; return; }
            const data = await r.json();
            subj.textContent = data.ticket.subject || '';
            chat.innerHTML = (data.messages || []).map(rowHtml).join('');
            scrollDown();
        }

        async function send() {
            const text = input.value.trim();
            if (!text) return;
            btn.disabled = true;
            try {
                const r = await fetch(`/api/support/tickets/${encodeURIComponent(ticketId)}/message`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ body: text })
                });
                if (r.ok) {
                    input.value = '';
                    // локально сразу добавим (сервер всё равно пушнёт)
                    const now = new Date().toISOString();
                    chat.insertAdjacentHTML('beforeend', rowHtml({ role: 'user', body: text, createdAt: now }));
                    scrollDown();
                }
            } finally { btn.disabled = false; }
        }

        btn.addEventListener('click', send);
        input.addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });

        // SignalR
        let connection;
        async function connectHub() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/tickets')
                .withAutomaticReconnect()
                .build();

            connection.on('message', (payload) => {
                if (!payload || payload.ticketId !== ticketId) return;
                const m = payload.message;
                chat.insertAdjacentHTML('beforeend', rowHtml(m));
                scrollDown();
            });

            await connection.start();
            await connection.invoke('JoinTicket', ticketId);
        }

        window.addEventListener('beforeunload', async () => {
            try { if (connection) await connection.invoke('LeaveTicket', ticketId); } catch {}
            try { if (connection) await connection.stop(); } catch {}
        });

        (async function init(){
            await loadTicket();
            await connectHub();
        })();
    </script>
}
