@page "/Content/Users/new_ticket"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "SupportDeskAccess")]
@model VCS_DOCs.Support.Pages.Content.Users.new_ticketModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
}
<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<style>
    html, body {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        background: transparent !important;
    }


    .wrap {
        padding: 16px;
    }

    .card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 24px rgba(0,0,0,.08);
        padding: 16px;
    }

    h3 {
        margin: 0 0 12px 0;
    }

    label {
        display: block;
        font-weight: 600;
        margin: 8px 0 6px;
    }

    input[type="text"], textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
        background: #fff;
        color: #111;
    }

    textarea {
        min-height: 140px;
        resize: vertical;
    }

    .actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .btn {
        height: 40px;
        padding: 0 14px;
        border-radius: 8px;
        border: 0;
        cursor: pointer;
        font-weight: 700;
    }

        .btn.primary {
            background: #2563eb;
            color: #fff;
        }

        .btn.ghost {
            background: #eef2ff;
            color: #1e3a8a;
        }

    .muted {
        color: #666;
        font-size: .9rem;
    }

    .ok {
        color: #059669;
    }

    .err {
        color: #b91c1c;
    }
</style>

<div class="wrap">
    <div class="card">
        <h3>Новая заявка</h3>
        <div class="muted" style="margin-bottom:8px;">Заголовок и текст будут отправлены в поддержку от вашего имени.</div>

        <form id="ntForm">
            <label for="ntSubject">Тема</label>
            <input id="ntSubject" name="subject" type="text" placeholder="Коротко о проблеме" />

            <label for="ntMessage">Текст</label>
            <textarea id="ntMessage" name="message" placeholder="Что произошло? Какие шаги приводят к ошибке?"></textarea>

            <div class="actions">
                <button class="btn ghost" type="button" id="ntCancel">Отмена</button>
                <button class="btn primary" type="submit" id="ntSubmit">Создать</button>
            </div>

            <div id="ntStatus" class="muted" style="margin-top:10px;"></div>
        </form>
    </div>
</div>

<script src="~/js/user/user_new_ticket.js" asp-append-version="true" defer></script>
