@page "/Content/Operators/all_close_userticket"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "SupportOnly")]
@model VCS_DOCs.Support.Pages.Content.Operators.AllCloseUserTicketsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
}

<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<link rel="stylesheet" href="~/css/sub_css/support_common_table.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/sub_css/operator_tickets_css/op_close_tickets.css" asp-append-version="true" />

<div id="op-close-tickets" class="profile_background accounts-page tickets-page">
    <div class="button-container">
        <h2>Закрытые заявки (все пользователи)</h2>

        <div class="filters-row">
            <div class="filters-left">
                <div id="scopeTabsClose" class="segmented" role="tablist" aria-label="Фильтр по назначению">
                    <button class="seg-btn is-active" role="tab" aria-selected="true" data-scope="all">Все</button>
                    <button class="seg-btn" role="tab" aria-selected="false" data-scope="mine">Только мои</button>
                    <button class="seg-btn" role="tab" aria-selected="false" data-scope="unassigned">Неназначенные</button>
                </div>

                <select id="op_close_orgFilter">
                    <option value="">Все организации</option>
                </select>
            </div>

            <div class="inline-controls">
                <input id="op_close_searchBox" class="user_searchBox" type="text" placeholder="Поиск (№, тема, пользователь, орг.)" />
                <button id="btn-op-close-search" class="button-sliding small">Найти</button>
            </div>
        </div>
    </div>

    <div class="tickets-legend">
        <span class="legend-item"><i class="legend-dot closed"></i> Закрыто</span>
    </div>

    <hr class="solid" />

    <div class="content-scrollable">
        <table class="file-table" id="opCloseTicketsTable">
            <colgroup>
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
            </colgroup>

            <thead>
                <tr>
                    <th>№</th>
                    <th>Тема</th>
                    <th>Пользователь</th>
                    <th>Организация</th>
                    <th>Статус</th>
                    <th>Обслуживает</th>
                    <th>Действие</th>
                </tr>
            </thead>

            <tbody id="opCloseTicketsBody"></tbody>

            <tfoot class="table-spacer">
                <tr><td colspan="7"></td></tr>
            </tfoot>
        </table>
    </div>
</div>
