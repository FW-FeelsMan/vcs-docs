@page "/Content/Operators/accounts"
@using VCS_DOCs.Infrastructure.Auth
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "SupportOnly")]
@model VCS_DOCs.Support.Pages.Content.Operators.AccountsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/sub_css/support_common_table.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/sub_css/support_accounts.css" asp-append-version="true" />

<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<div id="op-accounts" class="profile_background accounts-page">
    <div class="button-container">
        <h2>Учетные записи</h2>

        <div class="filters-row">
            <div class="filters-left">
                <select id="roleFilter" class="button-sliding small">
                    <option value="">Все роли</option>
                    <option value="@Roles.BaseUser">Пользователи</option>
                    <option value="@Roles.SupportAgent">Саппорт</option>
                    <option value="@Roles.SupportAdmin">Админы</option>
                </select>

                <select id="orgFilter" class="button-sliding small">
                    <option value="">Все организации</option>
                </select>
            </div>

            <div class="inline-controls">
                <input id="searchBox" class="user_searchBox" type="text" placeholder="Поиск (логин/ФИО)" />
                <button id="btn-add-project" class="button-sliding primary small">
                    Добавить проект
                </button>
            </div>
        </div>
    </div>

    <hr class="solid" />

    <div class="content-scrollable">
        <div class="files-table-wrap">
            <table class="file-table" id="accountsTable">
            <colgroup>
                <col style="width:110px" />
                <col style="width:200px" />
                <col style="width:150px" />
                <col style="width:100px" />
                <col style="width:120px" />
                <col style="width:100px" />
                <col style="width:160px" />
                <col style="width:350px" />
            </colgroup>

            <thead id="accountsHead"></thead>

            <tbody id="accountsBody">
                <tr><td colspan="8">Загрузка…</td></tr>
            </tbody>

            <tfoot class="table-spacer"><tr><td colspan="8"></td></tr></tfoot>
            </table>
        </div>
    </div>
</div>

<div id="add-project-modal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width:520px;">
        <h3>Добавить проект</h3>
        <div style="display:grid; grid-template-columns: 140px 1fr; gap:10px; text-align:left;">
            <label>Код</label><input id="ap-code" type="text" placeholder="Напр. VDocsExt" />
            <label>Имя</label><input id="ap-name" type="text" placeholder="Отображаемое имя" />
            <label>Тип</label>
            <select id="ap-type">
                <option value="External">External</option>
                <option value="InternalVSupport">InternalVSupport</option>
                <option value="SignalR">SignalR</option>
                <option value="Http">Http</option>
                <option value="Sql">Sql</option>
            </select>
            <label>BaseUrl/HubUrl</label><input id="ap-url" type="text" placeholder="https://host/..." />
            <label>Включен</label><input id="ap-enabled" type="checkbox" checked />
            <label>Возможности</label>
            <div>
                <label class="checkbox"><input type="checkbox" id="cap-presence" checked /> Presence</label>
                <label class="checkbox" style="margin-left:12px;"><input type="checkbox" id="cap-kick" checked /> Kick</label>
                <label class="checkbox" style="margin-left:12px;"><input type="checkbox" id="cap-tasks" /> Tasks</label>
            </div>
        </div>
        <div class="modal-buttons" style="margin-top:16px;">
            <button id="ap-save" class="button-sliding primary">Сохранить</button>
            <button id="ap-cancel" class="button-sliding">Отмена</button>
        </div>
    </div>
</div>

