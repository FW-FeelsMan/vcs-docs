@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using System.Security.Claims

@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var csrfToken = tokens.RequestToken;
    var userIdFromClaims = Context.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VCS-DOCs.Support</title>

    @await Html.PartialAsync("~/Pages/Shared/Styles/Styles_Layout.cshtml")
    @RenderSection("Styles", required: false)
    @await Html.PartialAsync("~/Pages/Shared/Scripts/Scripts_Libraries.cshtml")

    <meta name="csrf-token" content="@csrfToken" />
</head>
<body>

    <div style="display:none;">@Html.AntiForgeryToken()</div>

    @RenderBody()

    @if (isAuthenticated)
    {
        <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
        <script src="~/js/support-presence.js" asp-append-version="true"></script>
        <meta name="support-sid" content="@Context.User.FindFirst("support_sid")?.Value" />
    }


    @RenderSection("Scripts", required: false)
    <script src="~/js/utils/support-click-shield.js" asp-append-version="true" defer></script>
    <link rel="stylesheet" href="~/css/utils/auto-tooltips.css" />
    <script src="~/js/utils/auto-tooltips.js" defer></script>
    <script src="~/js/support/op/open-tickets-columns-resize.js" defer></script>
    <script src="~/js/support/op/close-tickets-columns-resize.js" defer></script>
    <script src="~/js/support/op/accounts-columns-resize.js" asp-append-version="true" defer></script>
    <script src="~/js/support/op/my-work-columns-resize.js" asp-append-version="true" defer></script>

</body>
</html>
