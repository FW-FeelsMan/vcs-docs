@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Вход";

    // Встраиваемый режим: если есть параметр ?embed (любое значение)
    var embedParam = Context?.Request?.Query["embed"].ToString();
    bool embedded = !string.IsNullOrEmpty(embedParam);
}
<!DOCTYPE html>
<html lang="ru" class="@(embedded ? "embedded" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — VCS_DOCs.Support</title>

    <!-- База -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Стили страницы (после базы, чтобы переопределять) -->
    @RenderSection("Styles", required: false)
</head>
<body class="@(embedded ? "embedded" : null)">
    @RenderBody()

    <!-- Скрипты по необходимости -->
    @RenderSection("Scripts", required: false)
</body>
</html>
