@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Service Desk";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — VCS‑DOCs Desk</title>
    <link id="deskStyle" rel="stylesheet" href="~/css/desk.css" />
</head>
<body>
    <div id="loader" class="loader hidden"></div>
    <div class="background"></div>

    <div class="header-container">
        <div class="header-title">VCS‑DOCs</div>
        <p class="menu_divider">Service<br/>Desk</p>
    </div>

    <aside class="sidebar">
        <div class="sidebar-button selected" data-content="open_tickets" id="btnOpen">
            <img src="~/images/projectsIcon.png" alt="Icon" class="button-icon">
            <span class="button-text">Открытые</span>
            <span class="button-number">12</span>
        </div>
        <div class="sidebar-button" data-content="closed_tickets" id="btnClosed">
            <img src="~/images/infographicIcon.png" alt="Icon" class="button-icon">
            <span class="button-text">Закрытые</span>
            <span class="button-number">34</span>
        </div>
        <div class="sidebar-button" data-content="contact_page" id="btnContact">
            <img src="~/images/helpIcon.png" alt="Icon" class="button-icon">
            <span class="button-text">Обратная связь</span>
            <span class="button-number">1</span>
        </div>
        <div class="sidebar-button" data-content="settings" id="btnSettings">
            <img src="~/images/extra.png" alt="Icon" class="button-icon">
            <span class="button-text">Настройки</span>
            <span class="button-number">⚙</span>
        </div>
    </aside>

    <main id="content" class="content-field">
        @RenderBody()
    </main>

    <script src="~/js/desk/sidebar.js" defer></script>
    @RenderSection("Scripts", required: false)
</body>
</html>