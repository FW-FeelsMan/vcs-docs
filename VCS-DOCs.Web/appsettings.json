{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "None",
      "Microsoft.Hosting.Lifetime": "None",
      "Microsoft.EntityFrameworkCore": "None",
      "Microsoft.AspNetCore": "None"
    }
  },
  "UserDataPathOptions": {
    "BasePath": "storage/userData"
  },
  "TaskEngineOptions": {
    "ModulesPath": "Modules"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=VCSDocs.db"
  },
  "AllowedHosts": "*",
  "CookiePolicyOptions": {
    "MinimumSameSitePolicy": "None",
    "Secure": "Always"
  },
  "HttpsPort": 7120,
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10737418240
    }
  },
  "IISServerOptions": {
    "MaxRequestBodySize": 10737418240
  }
}
