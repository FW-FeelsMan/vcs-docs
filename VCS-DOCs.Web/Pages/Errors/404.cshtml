@page
@model VCS_DOCs.Pages.Errors._404Model
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Страница не найдена</title>
    <link rel="stylesheet" href="/css/main_css/mainStyle.css" />
</head>
<body>
    <div class="error-background"></div>
    <div class="error-container">
        <div class="error-code">404</div>
        <div class="error-message">Страница не найдена</div>
        <div class="error-description">
            Увы, но этой страницы не существует. Возможно, она была удалена или вы ошиблись адресом.
        </div>
        <div class="error-buttons">
            <a href="/">На главную</a>
            <a href="mailto:support@yourdomain.local">Поддержка</a>
        </div>
    </div>
</body>
</html>
