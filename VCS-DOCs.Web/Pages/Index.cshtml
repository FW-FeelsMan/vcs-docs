@page
@model IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Главная страница";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sub_css/profile_page.css" />
}

<div id="loader" class="loader hidden"></div>
<div class="background"></div>

<div class="header-container">
    <div class="header-title">VCS-DOCs</div>
    <p class="menu_divider">Version<br>Control<br>System</p>
</div>

<div class="sidebar">
    <div class="sidebar-button" id="button1" data-content="project_page" data-style="projectsStyle">
        <img class="button-icon" src="~/images/projectsIcon.png" alt="Icon" />
        <span class="button-text">Проекты</span>
        <span class="button-number">1</span>
    </div>

    <div class="sidebar-button" id="button2" data-content="profile_page" data-style="profileStyle">
        <img class="button-icon" src="~/images/personalIcon.png" alt="Icon" />
        <span class="button-text">Профиль</span>
        <span class="button-number">2</span>
    </div>

    <div class="sidebar-button" id="button3" data-content="infographics_page" data-style="infographicsStyle">
        <img class="button-icon" src="~/images/infographicIcon.png" alt="Icon" />
        <span class="button-text">Инфографика</span>
        <span class="button-number">3</span>
    </div>

    <div class="sidebar-button" id="button4" data-content="contact_page" data-style="contactStyle">
        <img class="button-icon" src="~/images/helpIcon.png" alt="Icon" />
        <span class="button-text">Обратная связь</span>
        <span class="button-number">4</span>
    </div>

    <div class="sidebar-button" id="button5" data-content="extra_page" data-style="extraStyle">
        <img class="button-icon" src="~/images/extra.png" alt="Icon" />
        <span class="button-text">Дополнения</span>
        <span class="button-number">5</span>
    </div>

    <div class="user-block">
        <img id="sidebarAvatar" class="sidebar-avatar-img" src="@Model.AvatarUrl" alt="Avatar" />

        <div class="user-info">
            <div class="user-name">@Model.CurrentUser?.UserName</div>
            <div class="user-status">Проверка статуса...</div>
        </div>
    </div>

    <form method="post" asp-page-handler="Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="logout-button">
            <img class="logout-icon" src="~/images/logout_icon.png" alt="Выход" />
        </button>
    </form>
</div>

<div id="content" class="content-field">
    @await Html.PartialAsync("_ContentProjects")
</div>

<div class="context-menu">
    <ul>
        <li>Открыть</li>
        <li>Вырезать</li>
        <li>Печать</li>
        <li>Настройки</li>
        <li>Выход</li>
    </ul>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Pages/Shared/Scripts/Scripts_Index.cshtml")
}
