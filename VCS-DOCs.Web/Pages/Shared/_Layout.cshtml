@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using StackExchange.Profiling
@using System.Security.Claims
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var csrfToken = tokens.RequestToken;
    var userIdFromClaims = Context.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VCS-DOCs</title>

    @await Html.PartialAsync("~/Pages/Shared/Styles/Styles_Layout.cshtml")
    @await RenderSectionAsync("Styles", required: false)
    @await Html.PartialAsync("~/Pages/Shared/Scripts/Scripts_Libraries.cshtml")

    <meta name="csrf-token" content="@csrfToken" />
</head>
<body>
    <div style="display:none;">
        @Html.AntiForgeryToken()
    </div>

    @if (isAuthenticated)
    {
        @await Html.PartialAsync("~/Pages/Content/chat_popup.cshtml")
    }

    @RenderBody()

    @if (isAuthenticated)
    {
        <!-- SignalR only for authenticated -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>
        <script>
            window.userIsAuthenticated = true;
            window.userStorageBasePath = "@((ViewData["UserStorageBasePath"] as string)?.Replace("\\", "\\\\") ?? "")";
            window.userIdFromClaims = "@userIdFromClaims";
        </script>
        <script src="~/js/chat/chat.js" defer></script>
        <script src="~/js/vdocs-presence.js" defer></script>
    }
    else
    {
        <script>window.userIsAuthenticated = false;</script>
    }

    @await RenderSectionAsync("Scripts", required: false)
    <mini-profiler />

    <script>
        // если вернулись "Назад" — перерисуем страницу (важно для logout-флоу)
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) location.reload();
        });
    </script>
</body>
</html>
