@page
@model VCS_DOCs.Pages.LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Вход";
}

@section Styles {
    <link rel="stylesheet" href="~/css/main_css/loginStyle.css" />
}

<div id="loader" class="loader-overlay hidden">
    <div class="loader"></div>
</div>

<div class="background"></div>

<div id="container" class="container">
    <div class="form-container sign-in-container">
        <form method="post" asp-page-handler="Login" asp-antiforgery="true">
            @Html.AntiForgeryToken()

            <input type="hidden" name="action" value="Login" />
            <input type="hidden" name="hardwareId" id="hardwareId" />

            <h1>Вход</h1>
            <p>Введите Ваши данные для входа в систему</p>

            <input type="text"
                   name="Username"
                   placeholder="Ваш логин"
                   value="@Model.Username"
                   required
                   maxlength="20"
                   data-maxlen="20" />
            <small class="field-hint" data-hint-for="Username" style="display:none;">Не более 20 символов</small>

            <div class="password-input">
                <input type="password"
                       name="Password"
                       id="loginPassword"
                       placeholder="Пароль"
                       autocomplete="on"
                       required
                       maxlength="100"
                       data-maxlen="100" />
                <button type="button"
                        class="password-toggle"
                        data-target="#loginPassword"
                        aria-label="Показать пароль"
                        aria-pressed="false">
                    <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 5c-7 0-11 7-11 7s4 7 11 7 11-7 11-7-4-7-11-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                    </svg>
                    <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M2.1 3.51 3.51 2.1 21.9 20.49 20.49 21.9l-3.07-3.07A11.9 11.9 0 0 1 12 20C5 20 1 12 1 12a21.4 21.4 0 0 1 4.73-5.89L2.1 3.51zM12 6c7 0 11 6 11 6a21.2 21.2 0 0 1-3.69 4.77l-2.15-2.15A5 5 0 0 0 9.38 6.85L7.76 5.23A12.2 12.2 0 0 1 12 6zm0 4a2 2 0 0 1 2 2c0 .2-.03.39-.08.57l-2.49-2.49c.18-.05.37-.08.57-.08zm-2 2c0-.2.03-.39.08-.57l2.49 2.49c-.18.05-.37.08-.57.08a2 2 0 0 1-2-2z" />
                    </svg>
                </button>
            </div>

            <small class="field-hint" data-hint-for="Password" style="display:none;">Не более 100 символов</small>

            <div class="error-message" style="display:none;"></div>

            <button type="submit">Войти</button>

            <div class="checkbox">
                <input class="custom-checkbox" type="checkbox" id="forceLogin" name="ForceLogin" value="true" />
                <label for="forceLogin">Войти принудительно</label>
            </div>
        </form>
    </div>

    <div class="form-container sign-up-container">
        <form method="post" asp-page-handler="Register" asp-antiforgery="true" class="signup-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="action" value="Register" />
            <input type="hidden" name="hardwareId" id="hardwareIdRegister" />

            <h1>Регистрация</h1>

            <!-- тип учётки ВСЕГДА сверху -->
            <select name="speciality" required class="account-type-select">
                <option value="" disabled selected>Выберите тип учетной записи</option>
                @foreach (var speciality in Model.Specialities)
                {
                    <option value="@speciality">@speciality</option>
                }
            </select>

            <!-- Обычная регистрация (1 колонка) -->
            <div class="reg-basic">
                <input type="text"
                       name="Username"
                       placeholder="Ваш логин"
                       required
                       maxlength="20"
                       data-maxlen="20" />
                <small class="field-hint" data-hint-for="Username" style="display:none;">Не более 20 символов</small>
                <input type="email"
                       name="Email"
                       placeholder="Почта"
                       required
                       maxlength="120"
                       data-maxlen="120" />
                <small class="field-hint" data-hint-for="Email" style="display:none;">Не более 120 символов</small>


                <div class="password-input">
                    <input type="password"
                           name="Password"
                           id="registerPassword"
                           placeholder="Пароль"
                           autocomplete="new-password"
                           required
                           maxlength="100"
                           data-maxlen="100" />
                    <button type="button"
                            class="password-toggle"
                            data-target="#registerPassword"
                            aria-label="Показать пароль"
                            aria-pressed="false">
                        <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 5c-7 0-11 7-11 7s4 7 11 7 11-7 11-7-4-7-11-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                        </svg>
                        <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M2.1 3.51 3.51 2.1 21.9 20.49 20.49 21.9l-3.07-3.07A11.9 11.9 0 0 1 12 20C5 20 1 12 1 12a21.4 21.4 0 0 1 4.73-5.89L2.1 3.51zM12 6c7 0 11 6 11 6a21.2 21.2 0 0 1-3.69 4.77l-2.15-2.15A5 5 0 0 0 9.38 6.85L7.76 5.23A12.2 12.2 0 0 1 12 6zm0 4a2 2 0 0 1 2 2c0 .2-.03.39-.08.57l-2.49-2.49c.18-.05.37-.08.57-.08zm-2 2c0-.2.03-.39.08-.57l2.49 2.49c-.18.05-.37-.08-.57-.08a2 2 0 0 1-2-2z" />
                        </svg>
                    </button>
                </div>

                <div class="password-input">
                    <input type="password"
                           name="ConfirmPassword"
                           id="registerPassword2"
                           placeholder="Повторите пароль"
                           autocomplete="new-password"
                           required
                           maxlength="100"
                           data-maxlen="100" />
                    <button type="button"
                            class="password-toggle"
                            data-target="#registerPassword2"
                            aria-label="Показать пароль"
                            aria-pressed="false">
                        <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 5c-7 0-11 7-11 7s4 7 11 7 11-7 11-7-4-7-11-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                        </svg>
                        <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M2.1 3.51 3.51 2.1 21.9 20.49 20.49 21.9l-3.07-3.07A11.9 11.9 0 0 1 12 20C5 20 1 12 1 12a21.4 21.4 0 0 1 4.73-5.89L2.1 3.51zM12 6c7 0 11 6 11 6a21.2 21.2 0 0 1-3.69 4.77l-2.15-2.15A5 5 0 0 0 9.38 6.85L7.76 5.23A12.2 12.2 0 0 1 12 6zm0 4a2 2 0 0 1 2 2c0 .2-.03.39-.08.57l-2.49-2.49c.18-.05.37-.08.57-.08zm-2 2c0-.2.03-.39.08-.57l2.49 2.49c-.18.05-.37-.08-.57-.08a2 2 0 0 1-2-2z" />
                        </svg>
                    </button>
                </div>

                <small class="field-hint" data-hint-for="ConfirmPassword" style="display:none;">Пароли должны совпадать</small>
                <small class="field-hint" data-hint-for="Password" style="display:none;">Не более 100 символов</small>
            </div>

            <!-- Регистрация организации (2 колонки) -->
            <div class="org-grid">
                <div class="org-col">
                    <h2 class="org-title">Данные организации</h2>

                    <input type="text" name="OrgName" placeholder="Название организации" maxlength="120" />
                    <input type="text" name="OrgInn" placeholder="ИНН организации" maxlength="20" inputmode="numeric" />
                    <input type="email" name="OrgEmail" placeholder="Email организации" maxlength="120" />
                    <input type="text" name="OrgCountry" placeholder="Страна" maxlength="80" />
                    <input type="text" name="OrgAddress" placeholder="Адрес" maxlength="200" />
                </div>

                <div class="org-col org-divider">
                    <h2 class="org-title">Данные владельца</h2>

                    <input type="text"
                           name="Username"
                           placeholder="Ваш логин"
                           maxlength="20"
                           data-maxlen="20" />
                    <input type="email" name="OwnerEmail" placeholder="Почта" maxlength="120" />
                    <input type="text" name="OwnerFullName" placeholder="ФИО" maxlength="120" />
                    <input type="text" name="OwnerPosition" placeholder="Должность" maxlength="120" />

                    <div class="password-input">
                        <input type="password"
                               name="Password"
                               id="orgRegisterPassword"
                               placeholder="Пароль"
                               autocomplete="new-password"
                               maxlength="100"
                               data-maxlen="100" />
                        <button type="button"
                                class="password-toggle"
                                data-target="#orgRegisterPassword"
                                aria-label="Показать пароль"
                                aria-pressed="false">
                            <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 5c-7 0-11 7-11 7s4 7 11 7 11-7 11-7-4-7-11-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                            </svg>
                            <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M2.1 3.51 3.51 2.1 21.9 20.49 20.49 21.9l-3.07-3.07A11.9 11.9 0 0 1 12 20C5 20 1 12 1 12a21.4 21.4 0 0 1 4.73-5.89L2.1 3.51zM12 6c7 0 11 6 11 6a21.2 21.2 0 0 1-3.69 4.77l-2.15-2.15A5 5 0 0 0 9.38 6.85L7.76 5.23A12.2 12.2 0 0 1 12 6zm0 4a2 2 0 0 1 2 2c0 .2-.03.39-.08.57l-2.49-2.49c.18-.05.37-.08.57-.08zm-2 2c0-.2.03-.39.08-.57l2.49 2.49c-.18.05-.37-.08-.57-.08a2 2 0 0 1-2-2z" />
                            </svg>
                        </button>
                    </div>

                    <div class="password-input">
                        <input type="password"
                               name="ConfirmPassword"
                               id="orgRegisterPassword2"
                               placeholder="Повторите пароль"
                               autocomplete="new-password"
                               maxlength="100"
                               data-maxlen="100" />
                        <button type="button"
                                class="password-toggle"
                                data-target="#orgRegisterPassword2"
                                aria-label="Показать пароль"
                                aria-pressed="false">
                            <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 5c-7 0-11 7-11 7s4 7 11 7 11-7 11-7-4-7-11-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                            </svg>
                            <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M2.1 3.51 3.51 2.1 21.9 20.49 20.49 21.9l-3.07-3.07A11.9 11.9 0 0 1 12 20C5 20 1 12 1 12a21.4 21.4 0 0 1 4.73-5.89L2.1 3.51zM12 6c7 0 11 6 11 6a21.2 21.2 0 0 1-3.69 4.77l-2.15-2.15A5 5 0 0 0 9.38 6.85L7.76 5.23A12.2 12.2 0 0 1 12 6zm0 4a2 2 0 0 1 2 2c0 .2-.03.39-.08.57l-2.49-2.49c.18-.05.37-.08.57-.08zm-2 2c0-.2.03-.39.08-.57l2.49 2.49c-.18.05-.37-.08-.57-.08a2 2 0 0 1-2-2z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            @if (Model.RegistrationErrors.Any())
            {
                <div class="error-message-registration" style="display:none;">
                    @foreach (var error in Model.RegistrationErrors)
                    {
                        <p>@error</p>
                    }
                </div>
            }

            <div class="error-message-registration" style="display:none;"></div>

            <div class="successful-message" style="display:none;">
                <p>Регистрация прошла успешно! Вы сможете войти в систему как только учетная запись будет активированна администрацией.</p>
            </div>

            <button type="submit" class="btn-submit" @(Model.IsRegistrationSuccessful ? "disabled" : null)>Зарегистрировать</button>
        </form>
    </div>

    <div class="overlay-container">
        <div class="overlay">
            <div class="overlay-panel overlay-left">
                <h1>Регистрация пользователя</h1>
                <p>Введите Ваши данные и нажмите кнопку "Зарегистрировать"</p>
                <button class="ghost" id="signIn" data-click="throttle:800" type="button">Вернуться</button>
            </div>

            <div class="overlay-panel overlay-right">
                <h1>VCS-DOCs</h1>
                <p>Еще не зарегистрированы в системе?</p>
                <button class="ghost" id="signUp" data-click="throttle:800" type="button">Зарегистрироваться</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fingerprintjs@3.3.0/dist/fp.min.js"></script>
    <script src="~/js/auth/auth-login.js" asp-append-version="true" defer></script>
    <script src="~/js/ui/support_modal.js" defer></script>
    <script src="~/js/auth/password-toggle.js" asp-append-version="true" defer></script>
}
