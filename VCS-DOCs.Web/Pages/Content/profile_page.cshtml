                                       placeholder="ДД.ММ.ГГГГ"
                                       pattern="\d{2}\.\d{2}\.\d{4}"
                                       disabled />
                            </div>

                            <div class="info-card">
                                <h4>
                                    Организация
                                    <button class="edit-button" data-click="throttle:800" type="button">
                                        <img src="~/images/edit_icon.png" alt="Edit" />
                                    </button>
                                </h4>
                                <p data-field="Organization">@Model.CurrentUser?.Organization</p>
                            </div>

                            <div class="info-card">
                                <h4>
                                    Подразделение
                                    <button class="edit-button" data-click="throttle:800" type="button">
                                        <img src="~/images/edit_icon.png" alt="Edit" />
                                    </button>
                                </h4>
                                <p data-field="Department">@Model.CurrentUser?.Department</p>
                            </div>

                            <div class="info-card">
                                <h4>Тип учетной записи</h4>
                                <p data-field="Speciality">@Model.CurrentUser?.Speciality</p>
                            </div>

                            <div class="info-card">
                                <h4>
                                    E-mail
                                    <button class="edit-button" data-click="throttle:800" type="button">
                                        <img src="~/images/edit_icon.png" alt="Edit" />
                                    </button>
                                </h4>
                                <p data-field="Email">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Email) ? Model.CurrentUser!.Email : "Не установлено")
                                </p>
                            </div>

                            <div class="info-card">
                                <h4>Удаление аккаунта</h4>
                                <button id="deleteAccountButton" class="button-sliding danger" type="button">Удалить</button>
                            </div>
                        </div>
                    </div>*@
                <div class="content-scrollable profile-content-scroll">
                    <div class="info-grid personal-form-grid">
                        <div class="info-card">
                            <div class="field-label">ФИО</div>
                            <div class="field-control">
                                <p data-field="FullName">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.FullName) ? Model.CurrentUser!.FullName : "Не установлено")
                                </p>

                                <button class="edit-button" data-click="throttle:800" type="button" title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">Дата рождения</div>
                            <div class="field-control">
                                <p data-field="DateOfBirth">
                                    @(Model.CurrentUser?.DateOfBirth is null ? "Не установлено" : $"{Model.CurrentUser!.DateOfBirth:dd.MM.yyyy}")
                                </p>

                                <button class="edit-button" data-click="throttle:800" type="button" title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">Организация</div>
                            <div class="field-control">
                                <p data-field="Organization">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Organization) ? Model.CurrentUser!.Organization : "Не установлено")
                                </p>

                                <button class="edit-button" data-click="throttle:800" type="button" title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">Подразделение</div>
                            <div class="field-control">
                                <p data-field="Department">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Department) ? Model.CurrentUser!.Department : "Не установлено")
                                </p>

                                <button class="edit-button" data-click="throttle:800" type="button" title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">Тип учетной записи</div>
                            <div class="field-control readonly">
                                <p data-field="Speciality">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Speciality) ? Model.CurrentUser!.Speciality : "Не установлено")
                                </p>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">E-mail</div>
                            <div class="field-control">
                                <p data-field="Email">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Email) ? Model.CurrentUser!.Email : "Не установлено")
                                </p>

                                <button class="edit-button" data-click="throttle:800" type="button" title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card danger-card">
                            <div class="field-label">Удаление аккаунта</div>
                            <div class="danger-actions">
                                <button id="deleteAccountButton" class="button-sliding danger" type="button">
                                    Удалить
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div id="storage" class="content-section">
                <h2>Личное хранилище</h2>

                <div class="storage-header" style="display:flex; align-items:center; justify-content:space-between;">
                    <div style="display:flex; align-items:center;">
                        <div style="margin-right:10px;">
                            <span id="storageCounter"></span>
                        </div>
                    </div>

                    <button id="uploadFileButton"
                            class="button-sliding primary"
                            type="button"
                            style="margin-left:auto; margin-right:30px;">
                        Загрузить файл
                    </button>
                </div>

                <div class="content-scrollable">
                    <table id="userFilesTable" class="file-table">
                        <thead>
                            <tr>
                                <th data-type="string">Имя файла</th>
                                <th>Версия</th>
                                <th data-type="number">Размер</th>
                                <th data-type="date">Загружен</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div id="tasks" class="content-section">
                <h2>Задачи</h2>
                <h3>Задачи пользователя, обрабатываемые на сервере</h3>

                <div id="tasksContainer" class="tasks-container">
                    <div class="tasks-scrollable">
                        <div id="taskCardList" class="tasks-grid"></div>
                    </div>
                </div>
            </div>

            <div id="settings" class="content-section">
                <h2>Настройки</h2>
                <h3>Раздел настроек аккаунта</h3>

                <div class="content-scrollable">
                    <div class="info-grid">
                        <div class="info-card">
                            <h4>Заглушка</h4>
                            <p>Добавим настройки позже.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="upload-version-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3 id="version-modal-title">Подтверждение</h3>
            <p id="version-conflict-message">Сообщение по умолчанию.</p>
            <div class="modal-buttons">
                <div id="split-button" class="multi-button split-button">
                    <div class="button-part label">Заменить:</div>
                    <div id="selected-version" class="button-part version">V4</div>
                    <div id="version-dropdown" class="button-part dropdown">&#9662;</div>
                </div>

                <div id="version-list" class="version-list" style="display:none;"></div>

                <button id="conflict-new-version" class="button-sliding primary" type="button">Новая версия</button>
                <button id="conflict-cancel" class="button-sliding primary" type="button">Отмена</button>
            </div>
        </div>
    </div>

    <div id="upload-warning-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3 id="warning-modal-title">Предупреждение</h3>
            <p id="warning-message">Подтверждение действия</p>
            <div class="modal-buttons">
                <button id="warning-confirm" class="button-sliding danger" type="button">Удалить</button>
                <button id="warning-cancel" class="button-sliding" type="button">Отмена</button>
            </div>
        </div>
    </div>

    <div id="upload-resume-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3 id="resume-modal-title">Продолжить загрузку?</h3>
            <p id="resume-modal-message">Файл уже загружался. Хотите продолжить?</p>
            <div class="modal-buttons">
                <button id="resume-confirm" class="button-sliding" type="button">Продолжить</button>
                <button id="resume-cancel" class="button-sliding" type="button">Начать заново</button>
            </div>
        </div>
    </div>

    <div id="upload-cancel-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3 id="cancel-modal-title">Отмена загрузки</h3>
            <p id="upload-cancel-message">
                Вы уверены? Было загружено 0%<br />
                ИмяФайла.ext<br />
                Отмена загрузки очистит прогресс.
            </p>
            <div class="modal-buttons">
                <button id="upload-cancel-confirm" class="button-sliding danger" type="button">Да, отменить</button>
                <button id="upload-cancel-close" class="button-sliding" type="button">Отмена</button>
            </div>
        </div>
    </div>

    <div id="upload-busy-modal" style="display:none;">
        <div class="upload-busy-message"></div>
        <button class="upload-busy-ok" data-click="throttle:800" type="button">Ок</button>
    </div>

    <div id="delete-account-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3>Удаление аккаунта</h3>
            <p style="margin:8px 0 12px;">
                Это действие пометит аккаунт как удалённый и выполнит выход.<br />
                Для подтверждения введите пароль.
            </p>

            <div style="text-align:left; margin:10px 0 6px;">
                <label for="delete-account-password" style="display:block; font-weight:700; margin-bottom:6px;">
                    Пароль
                </label>
                <input id="delete-account-password"
                       type="password"
                       autocomplete="current-password"
                       style="width:100%; box-sizing:border-box; padding:10px; border:1px solid #ddd; border-radius:8px;" />
                <div id="delete-account-error"
                     style="display:none; margin-top:8px; color:#dc3545; font-weight:700;">
                    Ошибка
                </div>
            </div>

            <div class="modal-buttons">
                <button id="delete-account-confirm" class="button-sliding danger" type="button">Удалить</button>
                <button id="delete-account-cancel" class="button-sliding" type="button">Отмена</button>
            </div>
        </div>
    </div>

    <div id="share-link-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3>Поделиться файлом</h3>

            <div class="row" style="display:flex; gap:12px; align-items:center; justify-content:center; margin:12px 0 16px;">
                <div id="share-ttl" class="multi-button split-button">
                    <div class="button-part label">Срок:</div>
                    <div class="button-part value" data-value="168">7 дней (168 ч)</div>
                    <div class="button-part dropdown" aria-label="Открыть варианты">▾</div>

                    <div class="action-dropdown-menu compact" style="display:none; min-width:260px;">
                        <div class="dropdown-item" data-value="12">12 часов</div>
                        <div class="dropdown-item" data-value="24">1 день (24 ч)</div>
                        <div class="dropdown-item" data-value="72">3 дня (72 ч)</div>
                        <div class="dropdown-item" data-value="168">7 дней (168 ч)</div>
                        <div class="dropdown-item" data-value="336">14 дней (336 ч)</div>
                        <div class="dropdown-item" data-value="720">30 дней (720 ч)</div>
                    </div>
                </div>

                <div id="share-limit" class="multi-button split-button">
                    <div class="button-part label">Лимит:</div>
                    <div class="button-part value" data-value="10">10 скачиваний</div>
                    <div class="button-part dropdown" aria-label="Открыть варианты">▾</div>

                    <div class="action-dropdown-menu compact" style="display:none; min-width:260px;">
                        <div class="dropdown-item" data-value="1">1 скачивание</div>
                        <div class="dropdown-item" data-value="10">10 скачиваний</div>
                        <div class="dropdown-item" data-value="50">50 скачиваний</div>
                        <div class="dropdown-item" data-value="100">100 скачиваний</div>
                        <div class="dropdown-item" data-value="unlimited">Без ограничений</div>
                    </div>
                </div>
            </div>

            <div class="row" style="margin:12px 0 16px;">
                <label class="checkbox">
                    <input id="share-auth-only" type="checkbox" checked />
                    <span>Только для зарегистрированных пользователей</span>
                </label>
            </div>

            <div class="row" style="margin-bottom:8px;">
                <input id="share-link-url"
                       type="text"
                       readonly
                       style="width:100%; box-sizing:border-box; display:none;"
                       placeholder="Ссылка появится после создания" />
            </div>

            <div class="modal-buttons">
                <button id="share-generate-copy" class="button-sliding primary" type="button">Скопировать ссылку</button>
                <button id="share-cancel" class="button-sliding" type="button">Отмена</button>
            </div>
        </div>
    </div>
</div>
