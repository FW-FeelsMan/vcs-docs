@page
@model VCS_DOCs.Pages.Content.profile_pageModel
@using System.Globalization

<input id="hiddenFileInput" type="file" style="display:none;" />
<input id="avatarFileInput" type="file" style="display:none;" accept="image/*" />

<div style="display:none;">
    @Html.AntiForgeryToken()

    @if (Model.CurrentUser is not null)
    {
        <meta name="user-id" content="@Model.CurrentUser.Id" />
    }
</div>

<div class="profile_background">

    <h2>VCS-DOSc Account</h2>
    <hr class="solid" />

    <div class="profile-container">
        <div class="profile-sidebar">
            <div class="avatar-wrapper">
                <label class="avatar-upload-label" for="avatarFileInput">
                    <img id="avatarImage"
                         src="@($"{Model.AvatarPath}?v={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}")"
                         alt="Avatar" />
                </label>

                <p class="username" data-field="FullName">@Model.CurrentUser?.UserName</p>
            </div>

            <ul class="sidebar-menu">
                <li class="active" data-target="personal-data">Персональные данные</li>
                <li data-target="storage">Личное хранилище</li>
                <li data-target="tasks">Задачи</li>
                <li data-target="settings">Настройки</li>
            </ul>
        </div>

        <div class="profile-content">
            <div id="personal-data" class="content-section active">
                <h2>Персональные данные</h2>
                <h3>Раздел управления личными данными</h3>
                <div class="content-scrollable profile-content-scroll">
                    <div class="info-grid personal-form-grid">
                        <div class="info-card">
                            <div class="field-label">ФИО</div>
                            <div class="field-control">
                                <p data-field="FullName">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.FullName)
                                        ? Model.CurrentUser!.FullName
                                        : "Не установлено")
                                </p>

                                <button class="edit-button"
                                        data-click="throttle:800"
                                        type="button"
                                        title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">Дата рождения</div>
                            <div class="field-control">
                                <p data-field="DateOfBirth">
                                    @(Model.CurrentUser?.DateOfBirth is null
                                        ? "Не установлено"
                                        : $"{Model.CurrentUser!.DateOfBirth:dd.MM.yyyy}")
                                </p>

                                <button class="edit-button"
                                        data-click="throttle:800"
                                        type="button"
                                        title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">Организация</div>
                            <div class="field-control">
                                <p data-field="Organization">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Organization)
                                        ? Model.CurrentUser!.Organization
                                        : "Не установлено")
                                </p>

                                <button class="edit-button"
                                        data-click="throttle:800"
                                        type="button"
                                        title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">Подразделение</div>
                            <div class="field-control">
                                <p data-field="Department">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Department)
                                        ? Model.CurrentUser!.Department
                                        : "Не установлено")
                                </p>

                                <button class="edit-button"
                                        data-click="throttle:800"
                                        type="button"
                                        title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">Тип учетной записи</div>
                            <div class="field-control readonly">
                                <p data-field="Speciality">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Speciality)
                                        ? Model.CurrentUser!.Speciality
                                        : "Не установлено")
                                </p>
                            </div>
                        </div>

                        <div class="info-card">
                            <div class="field-label">E-mail</div>
                            <div class="field-control">
                                <p data-field="Email">
                                    @(!string.IsNullOrWhiteSpace(Model.CurrentUser?.Email)
                                        ? Model.CurrentUser!.Email
                                        : "Не установлено")
                                </p>

                                <button class="edit-button"
                                        data-click="throttle:800"
                                        type="button"
                                        title="Редактировать">
                                    <img src="~/images/edit_icon.png" alt="Edit" />
                                </button>
                            </div>
                        </div>

                        <div class="info-card danger-card">
                            <div class="field-label">Удаление аккаунта</div>
                            <div class="danger-actions">
                                <button id="deleteAccountButton"
                                        class="button-sliding danger"
                                        type="button">
                                    Удалить
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="storage" class="content-section">
                <h2>Личное хранилище</h2>

                <div class="storage-header" style="display:flex; align-items:center; justify-content:space-between;">
                    <div style="display:flex; align-items:center;">
                        <div style="margin-right:10px;">
                            <span id="storageCounter"></span>
                        </div>
                    </div>

                    <button id="uploadFileButton"
                            class="button-sliding primary"
                            type="button"
                            style="margin-left:auto; margin-right:30px;">
                        Загрузить файл
                    </button>
                </div>

                <div class="content-scrollable">
                    <div class="files-table-wrap">
                        <table id="userFilesTable" class="file-table">
                            <thead>
                                <tr>
                                    <th data-type="string">Имя файла</th>
                                    <th>Версия</th>
                                    <th data-type="number">Размер</th>
                                    <th data-type="date">Загружен</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="tasks" class="content-section">
                <h2>Задачи</h2>
                <h3>Задачи пользователя, обрабатываемые на сервере</h3>

                <div id="tasksContainer" class="tasks-container">
                    <div class="tasks-scrollable">
                        <div id="taskCardList" class="tasks-grid"></div>
                    </div>
                </div>
            </div>

            <div id="settings" class="content-section">
                <h2>Настройки</h2>
                <h3>Раздел настроек аккаунта</h3>

                <div class="content-scrollable">
                    <div class="info-grid">
                        <div class="info-card">
                            <h4>Заглушка</h4>
                            <p>Добавим настройки позже.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="upload-version-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3 id="version-modal-title">Подтверждение</h3>
            <p id="version-conflict-message">Сообщение по умолчанию.</p>
            <div class="modal-buttons">
                <div id="split-button" class="multi-button split-button">
                    <div class="button-part label">Заменить:</div>
                    <div id="selected-version" class="button-part version">V4</div>
                    <div id="version-dropdown" class="button-part dropdown">&#9662;</div>
                </div>

                <div id="version-list" class="version-list" style="display:none;"></div>

                <button id="conflict-new-version"
                        class="button-sliding primary"
                        type="button">
                    Новая версия
                </button>
                <button id="conflict-cancel"
                        class="button-sliding primary"
                        type="button">
                    Отмена
                </button>
            </div>
        </div>
    </div>

    <div id="upload-warning-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3 id="warning-modal-title">Предупреждение</h3>
            <p id="warning-message">Подтверждение действия</p>
            <div class="modal-buttons">
                <button id="warning-confirm"
                        class="button-sliding danger"
                        type="button">
                    Удалить
                </button>
                <button id="warning-cancel"
                        class="button-sliding"
                        type="button">
                    Отмена
                </button>
            </div>
        </div>
    </div>

    <div id="upload-resume-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3 id="resume-modal-title">Продолжить загрузку?</h3>
            <p id="resume-modal-message">
                Файл уже загружался. Хотите продолжить?
            </p>
            <div class="modal-buttons">
                <button id="resume-confirm"
                        class="button-sliding"
                        type="button">
                    Продолжить
                </button>
                <button id="resume-cancel"
                        class="button-sliding"
                        type="button">
                    Начать заново
                </button>
            </div>
        </div>
    </div>

    <div id="upload-cancel-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3 id="cancel-modal-title">Отмена загрузки</h3>
            <p id="upload-cancel-message">
                Вы уверены? Было загружено 0%<br />
                ИмяФайла.ext<br />
                Отмена загрузки очистит прогресс.
            </p>
            <div class="modal-buttons">
                <button id="upload-cancel-confirm"
                        class="button-sliding danger"
                        type="button">
                    Да, отменить
                </button>
                <button id="upload-cancel-close"
                        class="button-sliding"
                        type="button">
                    Отмена
                </button>
            </div>
        </div>
    </div>

    <div id="upload-busy-modal" style="display:none;">
        <div class="upload-busy-message"></div>
        <button class="upload-busy-ok"
                data-click="throttle:800"
                type="button">
            Ок
        </button>
    </div>

    <div id="delete-account-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3>Удаление аккаунта</h3>
            <p style="margin:8px 0 12px;">
                Это действие пометит аккаунт как удалённый и выполнит выход.<br />
                Для подтверждения введите пароль.
            </p>

            <div style="text-align:left; margin:10px 0 6px;">
                <label for="delete-account-password"
                       style="display:block; font-weight:700; margin-bottom:6px;">
                    Пароль
                </label>
                <input id="delete-account-password"
                       type="password"
                       autocomplete="current-password"
                       style="width:100%; box-sizing:border-box; padding:10px; border:1px solid #ddd; border-radius:8px;" />
                <div id="delete-account-error"
                     style="display:none; margin-top:8px; color:#dc3545; font-weight:700;">
                    Ошибка
                </div>
            </div>

            <div class="modal-buttons">
                <button id="delete-account-confirm"
                        class="button-sliding danger"
                        type="button">
                    Удалить
                </button>
                <button id="delete-account-cancel"
                        class="button-sliding"
                        type="button">
                    Отмена
                </button>
            </div>
        </div>
    </div>

    <div id="shareModal" class="share-modal" aria-hidden="true">
        <div class="share-modal-overlay" data-share-close="overlay"></div>

        <div class="share-modal-dialog">
            <div class="share-modal-content"> 
                <button class="share-modal-close"
                        type="button"
                        aria-label="Закрыть"
                        data-share-close="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 6L6 18M6 6l12 12" />
                    </svg>
                </button>

                <div class="share-modal-header">
                    <h2 class="share-modal-title">Поделиться файлом</h2>
                    <p class="share-modal-subtitle">Создайте безопасную ссылку для обмена</p>
                </div>

                <div class="share-modal-body">
                    <div class="share-file-card">
                        <div class="share-file-icon" data-share-file-ext></div>
                        <div class="share-file-info">
                            <div class="share-file-name" data-share-file-name>
                                Презентация_Проект.docx
                            </div>
                            <div class="share-file-meta">
                                <span data-share-file-size>2.4 МБ</span>
                                <span class="share-file-divider">•</span>
                                <span data-share-file-version>Версия 3</span>
                            </div>
                        </div>
                    </div>

                    <div class="share-settings-grid">
                        <div class="share-setting">
                            <label class="share-setting-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="M12 6v6l4 2" />
                                </svg>
                                Срок действия
                            </label>
                            <select class="share-select" data-share-expire>
                                <option value="12">12 часов</option>
                                <option value="24">1 день</option>
                                <option value="72">3 дня</option>
                                <option value="168" selected>7 дней</option>
                                <option value="336">14 дней</option>
                                <option value="720">30 дней</option>
                            </select>
                        </div>

                        <div class="share-setting">
                            <label class="share-setting-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                                </svg>
                                Лимит скачиваний
                            </label>
                            <select class="share-select" data-share-download-limit>
                                <option value="1">1 скачивание</option>
                                <option value="10" selected>10 скачиваний</option>
                                <option value="50">50 скачиваний</option>
                                <option value="100">100 скачиваний</option>
                                <option value="unlimited">Без ограничений</option>
                            </select>
                        </div>
                    </div>

                    <label class="share-checkbox">
                        <input type="checkbox" checked data-share-auth-only>
                        <span class="share-checkbox-mark"></span>
                        <span class="share-checkbox-label">Только для авторизованных пользователей</span>
                    </label>

                    <div id="shareLinkBox" class="share-link-box" style="display:none;">
                        <label class="share-link-label">Ссылка готова</label>
                        <div class="share-link-input-group">
                            <input type="text"
                                   id="shareLinkUrl"
                                   class="share-link-input"
                                   readonly />
                            <button type="button"
                                    class="share-link-copy"
                                    title="Скопировать"
                                    data-share-copy>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                </svg>
                            </button>
                        </div>
                        <div class="share-link-hint">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M12 16v-4M12 8h.01" />
                            </svg>
                            Ссылка автоматически скопирована в буфер обмена
                        </div>
                    </div>
                </div>

                <div class="share-modal-footer">
                    <button type="button"
                            class="share-btn share-btn-secondary"
                            data-share-close="button">
                        Отмена
                    </button>

                    <button type="button"
                            class="share-btn share-btn-primary"
                            id="shareGenerateBtn"
                            data-share-generate>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                            <polyline points="22 4 12 14.01 9 11.01" />
                        </svg>
                        Создать ссылку
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>
