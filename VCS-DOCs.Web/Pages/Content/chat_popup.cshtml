<div id="chat-toggle-button" title="Открыть чат">
    <span class="chat-label">Центр уведомлений</span>
    <div class="chat-arrow-container">
        <div class="notification-badge" style="display: none;">0</div>
        <div class="chat-arrow"></div>
    </div>
</div>

<div id="chatbox" class="collapsed">
    <div id="topmenu">
        <span class="active">Контакты</span>
        <span>Чаты</span>
        <span>Задачи</span>
    </div>

    <div id="chat-tab-contacts" class="chat-tab-content">
        <div id="friendslist">
            <div id="friends">
                <div class="friend">
                    <img src="~/images/default_avatar.png" alt="Avatar" />
                    <p>
                        <strong>Колотов Михаил Викторович</strong>
                        <span>warmenzim@gmail.com</span>
                    </p>
                    <div class="status available"></div>
                </div>
            </div>
            <input type="text" id="searchfield" placeholder="Поиск контактов..." />
        </div>
    </div>

    <div id="chat-tab-chats" class="chat-tab-content" style="display: none;">
        <div id="chatview" class="p1">
            <div id="profile">
                <div id="minimize" title="Свернуть чат"></div>
                <div id="close" title="Закрыть чат">
                    <div class="cy"></div>
                    <div class="cx"></div>
                </div>

                <div id="profile-info">
                    <p>Алексей Петров</p>
                    <span>alexey.petrov@example.com</span>
                </div>
            </div>

            <div id="chat-messages">
                <label>Сегодня</label>
            </div>

            <div id="sendmessage">
                <input type="text" placeholder="Введите сообщение..." />
                <button id="send" type="button"></button>
            </div>
        </div>
    </div>

    <div id="chat-tab-tasks" class="chat-tab-content" style="display: none;">
        <div id="taskCardListChat" class="tasks-grid chat-task-style"></div>
    </div>
</div>
