@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using StackExchange.Profiling
@using System.Security.Claims
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var csrfToken = tokens.RequestToken;
    var userIdFromClaims = Context.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VCS-DOCs</title>

    <!-- Базовые стили проекта -->
    @await Html.PartialAsync("~/Pages/Shared/Styles/Styles_Layout.cshtml")

    <!-- Дополнительные стили страницы -->
    @await RenderSectionAsync("Styles", required: false)

    <!-- Библиотеки -->
    @await Html.PartialAsync("~/Pages/Shared/Scripts/Scripts_Libraries.cshtml")

    <!-- CSRF Token -->
    <meta name="csrf-token" content="@csrfToken" />
</head>
<body>
    <div style="display:none;">
        @Html.AntiForgeryToken()
    </div>

    <!-- Чат-попап заранее -->
    @await Html.PartialAsync("~/Pages/Content/chat_popup.cshtml")

    <!-- Основное содержимое -->
    @RenderBody()

    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>

    <!-- Глобальные переменные -->
    <script>
        var userIsAuthenticated = @(isAuthenticated.ToString().ToLower());
        @if (isAuthenticated)
        {
            <text>
                window.userStorageBasePath = "@((ViewData["UserStorageBasePath"] as string)?.Replace("\\", "\\\\") ?? "")";
                window.userIdFromClaims = "@userIdFromClaims";
            </text>
        }
    </script>

    <!-- Скрипты страницы -->
    @await RenderSectionAsync("Scripts", required: false)
    <mini-profiler />
    <script src="~/js/chat/chat.js" defer></script>
</body>
</html>
