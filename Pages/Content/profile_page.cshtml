@page
@model profile_pageModel
@{
}
@using System.Globalization

<input type="file" id="hiddenFileInput" style="display: none;" />

<div style="display:none;">
    @Html.AntiForgeryToken()
</div>
<div class="profile_background">
    <div class="button-container">
        <h2>VCS-DOSc Account</h2>
        <button class="button-sliding primary">Выйти</button>
    </div>
    <hr class="solid">
    <div class="profile-container">
        <div class="profile-sidebar">
            <input type="file" id="avatarFileInput" style="display: none;" accept="image/*" />

            <div class="avatar-wrapper">
                <label for="avatarFileInput" class="avatar-upload-label">
                    <img id="avatarImage" src="@($"{Model.AvatarPath}?v={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}")" alt="Avatar" />
                </label>
                <p data-field="FullName" class="username">@Model.CurrentUser?.UserName</p>
            </div>

            <ul class="sidebar-menu">
                <li class="active" data-target="personal-data">Персональные данные</li>
                <li data-target="storage">Личное хранилище</li>
                <li data-target="tasks">Задачи</li>
            </ul>
        </div>
        <div class="profile-content">
            <div id="personal-data" class="content-section active">
                <h2>Персональные данные</h2>
                <h3>Раздел управления личными данными</h3>
                <div class="info-grid">
                    <div class="info-card">
                        <h4>ФИО <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                        <p data-field="FullName">@Model.CurrentUser?.FullName</p>
                    </div>
                    <div class="info-card">
                        <h4>Дата рождения <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                        <input type="text"
                               class="date-input"
                               data-field="DateOfBirth"
                               value="@($"{Model.CurrentUser?.DateOfBirth:dd.MM.yyyy}")"
                               placeholder="ДД.ММ.ГГГГ"
                               pattern="\d{2}\.\d{2}\.\d{4}"
                               disabled />
                    </div>
                    <div class="info-card">
                        <h4>Организация <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                        <p data-field="Organization">@Model.CurrentUser?.Organization</p>
                    </div>
                    <div class="info-card">
                        <h4>Подразделение <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                        <p data-field="Department">@Model.CurrentUser?.Department</p>
                    </div>
                    <div class="info-card">
                        <h4>Должность <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                        <p data-field="Speciality">@Model.CurrentUser?.Speciality</p>
                    </div>
                    <div class="info-card">
                        <h4>Удаление аккаунта</h4>
                        <button class="button-sliding primary">Удалить</button>
                    </div>
                </div>
            </div>
            <div id="storage" class="content-section">
                <h2>Личное хранилище</h2>
                <div class="storage-header" style="display: flex; align-items: center; justify-content: space-between;">
                    <h3>Содержимое:</h3>
                    <div style="display: flex; align-items: center;">
                        <div style="margin-right: 10px;">
                            <span id="storageCounter"></span>
                        </div>
                        <button id="uploadFileButton" type="button" class="button-sliding primary">Загрузить файл</button>
                    </div>
                </div>
                <div class="content-scrollable">
                    <div class="table-scroll-wrapper">
                        <table class="sortable fixed-width-table">
                            <thead>
                                <tr>
                                    <th class="filename-col">Имя файла</th>
                                    <th class="version-col">Версия</th>
                                    <th class="size-col">Размер, Мб</th>
                                    <th class="date-col">Дата и время загрузки</th>
                                    <th class="command-col">Команда</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Динамически заполняется -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div id="tasks" class="content-section">
                <h2>Задачи</h2>
                <h3>Задачи пользователя, обрабатываемые на сервере</h3>
                <div class="tasks-container" id="tasksContainer">
                    <div class="tasks-grid">
                        <!-- Динамически создаются задачи загрузки -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="upload-conflict-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <p id="conflict-message">Сообщение по умолчанию.</p>
            <div class="modal-buttons">
                <button id="conflict-replace" class="btn btn-warning">Заменить</button>
                <button id="conflict-new-version" class="btn btn-info">Новая версия</button>
                <button id="conflict-cancel" class="btn">Отмена</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("~/Pages/Shared/Scripts/Scripts_profile_page.cshtml")
}