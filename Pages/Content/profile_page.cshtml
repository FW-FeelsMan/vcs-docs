@page 
@model profile_pageModel
@{
    Layout = null;
}
<form method="post" id="anti-forgery-form" style="display: none;">
    @Html.AntiForgeryToken()
</form>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Профиль</title>
    <link rel="stylesheet" href="~/css/sub_css/profile_page.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <div style="display:none;">
        @Html.AntiForgeryToken()
    </div>
    <div class="profile_background">
        <div class="button-container">
            <h2>VCS-DOSc Account</h2>
            <button class="css-button-sliding-to-left--red">Выйти</button>
        </div>
        <hr class="solid">

        <div class="profile-container">
            <div class="profile-sidebar">
                <div class="avatar">
                    <img src="~/images/default_avatar.png" alt="Icon">
                </div>
                <p data-field="FullName">@Model.CurrentUser?.Username</p>
                <ul class="sidebar-menu">
                    <li class="active" data-target="personal-data">Персональные данные</li>
                    <li data-target="storage">Личное хранилище</li>
                    <li data-target="tasks">Задачи</li>
                </ul>
            </div>

            <div class="profile-content">
                <div id="personal-data" class="content-section active">
                    <h2>Персональные данные</h2>
                    <h3>Раздел управления личными данными</h3>
                    <div class="info-grid">
                        <div class="info-card">
                            <h4>ФИО <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                            <p data-field="FullName">@Model.CurrentUser?.FullName</p>
                        </div>
                        <div class="info-card">
                            <h4>Дата рождения <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                            <p data-field="DateOfBirth">@Model.CurrentUser?.DateOfBirth</p>
                        </div>
                        <div class="info-card">
                            <h4>Организация <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                            <p data-field="Organization">@Model.CurrentUser?.Organization</p>
                        </div>
                        <div class="info-card">
                            <h4>Подразделение <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                            <p data-field="Department">@Model.CurrentUser?.Department</p>
                        </div>
                        <div class="info-card">
                            <h4>Должность <button class="edit-button"><img src="~/images/edit_icon.png" alt="Edit"></button></h4>
                            <p data-field="Speciality">@Model.CurrentUser?.Speciality</p>
                        </div>
                        <div class="info-card">
                            <h4>Удаление аккаунта</h4>
                            <button class="css-button-sliding-to-left--red">Удалить</button>
                        </div>
                    </div>
                </div>

                <div id="storage" class="content-section">
                    <h2>Личное хранилище</h2>
                    <h3>Содержимое личного хранилища пользователя</h3>
                    <div class="content-scrollable">
                        <table class="sortable">
                            <thead>
                                <tr>
                                    <th class="sorttable_alpha" style="min-width: 200px;">
                                        <div class="header-wrapper">
                                            <div class="cell-content">Имя файла</div>
                                        </div>
                                    </th>
                                    <th class="sorttable_alpha" style="min-width: 200px;">
                                        <div class="header-wrapper">
                                            <div class="cell-content">Размер, Мб</div>
                                        </div>
                                    </th>
                                    <th class="sorttable_alpha" style="min-width: 200px;">
                                        <div class="header-wrapper">
                                            <div class="cell-content">Дата и время загрузки</div>
                                        </div>
                                    </th>
                                    <th class="sorttable_alpha" style="min-width: 200px;">
                                        <div class="header-wrapper">
                                            <div class="cell-content">Команда</div>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="cell-content">
                                            filename_1filename_1filename_1filename_1filename_1filename_1filename_1filename_1filename_1filename_1filename_1filename_1filename_1.stp
                                        </div>
                                    </td>
                                    <td>30.1</td>
                                    <td>10.05.1993, 18:01</td>
                                    <td>
                                        <button class="delete-button">Удалить</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="tasks" class="content-section">
                    <h2>Задачи</h2>
                    <h3>Задачи пользователя, обрабатываемые на сервере</h3>
                    <div class="tasks-container">
                        <div class="tasks-grid">
                            <div class="task-card">
                                <div class="task-header">
                                    <span class="task-status processing">В обработке</span>
                                    <span class="task-time">10:45, 25.10.2023</span>
                                </div>
                                <div class="task-content">
                                    <h4>Обработка файла: <span class="task-filename">project_final.stp</span></h4>
                                    <div class="task-progress">
                                        <div class="progress-bar" style="width: 65%;"></div>
                                    </div>
                                    <p class="task-details">Файл находится в процессе обработки. Осталось примерно 2 минуты.</p>
                                </div>
                                <div class="task-actions">
                                    <button class="task-cancel-button">Отменить</button>
                                </div>
                            </div>

                            <div class="task-card completed">
                                <div class="task-header">
                                    <span class="task-status completed">Завершено</span>
                                    <span class="task-time">09:30, 24.10.2023</span>
                                </div>
                                <div class="task-content">
                                    <h4>Обработка файла: <span class="task-filename">design_v2.stp</span></h4>
                                    <div class="task-progress">
                                        <div class="progress-bar" style="width: 100%;"></div>
                                    </div>
                                    <p class="task-details">Файл успешно обработан. <a href="#" class="download-link">Скачать результат</a></p>
                                </div>
                            </div>

                            <div class="task-card cancelled">
                                <div class="task-header">
                                    <span class="task-status cancelled">Отменено</span>
                                    <span class="task-time">15:20, 23.10.2023</span>
                                </div>
                                <div class="task-content">
                                    <h4>Обработка файла: <span class="task-filename">draft_project.stp</span></h4>
                                    <div class="task-progress">
                                        <div class="progress-bar" style="width: 30%;"></div>
                                    </div>
                                    <p class="task-details">Задача была отменена пользователем.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
